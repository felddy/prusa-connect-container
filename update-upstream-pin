#!/usr/bin/env sh

# update-upstream-pin: rewrite ARG PRUSA_CONNECT_SHA256 in the Dockerfile to
# the sha256 digest GitHub reports for the source archive of the release
# named by ARG PRUSA_CONNECT_VERSION.
#
# Used by Renovate's postUpgradeTasks so the checksum lands in the same
# commit as the version bump; equally runnable by hand after editing the
# version pin. Runs under node (which Renovate's image always carries)
# rather than curl/jq, which it may not.

set -eu

VERSION=$(sed -n 's/^ARG PRUSA_CONNECT_VERSION=//p' Dockerfile | head -n 1)
if [ -z "${VERSION}" ]; then
  echo "ERROR: no ARG PRUSA_CONNECT_VERSION pin found in Dockerfile" >&2
  exit 1
fi

ASSET="prusa-connect-${VERSION}-source.tar.gz"
URL="https://api.github.com/repos/prusa3d/prusa-connect/releases/tags/v${VERSION}"

# shellcheck disable=SC2016 # the ${...} below are JS template literals
SHA256=$(node -e '
  const [url, asset] = process.argv.slice(1);
  const headers = { "User-Agent": "update-upstream-pin" };
  if (process.env.GITHUB_TOKEN) {
    headers.Authorization = `Bearer ${process.env.GITHUB_TOKEN}`;
  }
  fetch(url, { headers })
    .then((r) => {
      if (!r.ok) throw new Error(`${r.status} ${r.statusText} for ${url}`);
      return r.json();
    })
    .then((release) => {
      const a = (release.assets || []).find((a) => a.name === asset);
      if (!a || !a.digest) throw new Error(`no digest for asset ${asset}`);
      console.log(a.digest.replace(/^sha256:/, ""));
    })
    .catch((err) => {
      console.error(err.message);
      process.exit(1);
    });
' "${URL}" "${ASSET}")

if ! printf '%s\n' "${SHA256}" | grep -Eq '^[0-9a-f]{64}$'; then
  echo "ERROR: '${SHA256}' does not look like a sha256 digest" >&2
  exit 1
fi

sed "s/^ARG PRUSA_CONNECT_SHA256=.*/ARG PRUSA_CONNECT_SHA256=${SHA256}/" Dockerfile > Dockerfile.tmp
mv Dockerfile.tmp Dockerfile

echo "Pinned prusa-connect ${VERSION} source archive to sha256 ${SHA256}"
