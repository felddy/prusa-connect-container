{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "prusa3d/prusa-connect",
      "description": "Track upstream Prusa Connect releases via version.txt",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "managerFilePatterns": [
        "/^version\\.txt$/"
      ],
      "matchStrings": [
        "^(?<currentValue>\\S+)\\s*$"
      ],
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "prusa3d/prusa-connect",
      "description": "Track the upstream release pinned in the Dockerfile",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "managerFilePatterns": [
        "/^Dockerfile$/"
      ],
      "matchStrings": [
        "ARG PRUSA_CONNECT_VERSION=(?<currentValue>\\S+)"
      ],
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "prusa3d/prusa-connect",
      "description": "Track the upstream refs pinned in the Kubernetes overlay",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "managerFilePatterns": [
        "/^deploy/kubernetes/kustomization\\.yaml$/"
      ],
      "matchStrings": [
        "deploy/kubernetes\\?ref=v(?<currentValue>\\S+)",
        "newTag: (?<currentValue>\\S+)"
      ],
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "felddy/reusable-workflows",
      "description": "Track the central lint-config base release pinned in the overlay",
      "managerFilePatterns": [
        "/^\\.pre-commit-overlay\\.yaml$/"
      ],
      "matchStrings": [
        "# lint-base-version: (?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "versioningTemplate": "semver-coerced"
    }
  ],
  "enabledManagers": [
    "custom.regex"
  ],
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "commitBody": "Release-As: {{{newVersion}}}",
      "commitMessageTopic": "Prusa Connect",
      "description": "Upstream ships prereleases only so far; without this rule Renovate would skip every -beta version.",
      "ignoreUnstable": false,
      "labels": [
        "bot :robot:",
        "dependencies :game_die:"
      ],
      "matchDepNames": [
        "prusa3d/prusa-connect"
      ],
      "postUpgradeTasks": {
        "commands": [
          "sh update-upstream-pin"
        ],
        "executionMode": "branch",
        "fileFilters": [
          "Dockerfile"
        ]
      },
      "prBodyNotes": [
        "`ARG PRUSA_CONNECT_SHA256` in the Dockerfile was rewritten to the new release's source-archive digest as part of this update.",
        "Release-As: {{{newVersion}}}"
      ]
    },
    {
      "commitMessageTopic": "lint config base",
      "labels": [
        "bot :robot:",
        "dependencies :game_die:"
      ],
      "matchDatasources": [
        "github-releases"
      ],
      "matchDepNames": [
        "felddy/reusable-workflows"
      ],
      "postUpgradeTasks": {
        "commands": [
          "sh lint-config-update"
        ],
        "executionMode": "branch",
        "fileFilters": [
          ".pre-commit-config.yaml"
        ]
      },
      "prBodyNotes": [
        "The generated `.pre-commit-config.yaml` was regenerated from the pinned central base as part of this update."
      ]
    }
  ]
}
